for f in src/lib/scotch*/src; do
   make -C $f realclean
done
# an explicit start directory: BSD find (macOS) has no default
find src \( -name '*.bck' -o -name '*.o' -o -name '*.so' -o -name '*.dll' -o -name '*.a'  -o -name '*.mod' \) -exec rm -f {} \;
find src \( -name 'tmp' -o -name 'build' \) -prune -exec rm -fr {} \;
rm -f .RData .Rhistory
