#!/bin/sh
# Remove build products, including those in the src/vendor subdirectories
# (R only cleans the top level of src). BSD find (macOS) needs the explicit
# start directory.
find src \( -name '*.o' -o -name '*.mod' -o -name '*.smod' -o -name '*.so' \
  -o -name '*.dll' -o -name '*.a' \) -exec rm -f {} \;
rm -f .RData .Rhistory
