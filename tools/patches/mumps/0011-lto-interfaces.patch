diff --git b/src/mumps_flytes_interfaces.h b/src/mumps_flytes_interfaces.h
new file mode 100644
index 0000000..c1910b4
--- /dev/null
+++ b/src/mumps_flytes_interfaces.h
@@ -0,0 +1,123 @@
+C
+C     rmumps: explicit interfaces of the complex-domain conversion
+C     kernels of mumps_flytes.c. C declares the complex matrix as
+C     double* or float* and reads it as pairs of reals; the Fortran
+C     callers pass COMPLEX(kind=8) or COMPLEX arrays. The argument is
+C     exempt from type, kind and rank checking so that the call and the
+C     definition agree under LTO. The byte array is INTEGER(1), as in
+C     the callers.
+C
+      INTERFACE
+      SUBROUTINE MUMPS_ZDOUBLE_FP56Z(A, B, NROWS, NCOLS, LDA, LDB)
+!GCC$ ATTRIBUTES NO_ARG_CHECK :: A
+!DEC$ ATTRIBUTES NO_ARG_CHECK :: A
+!DIR$ IGNORE_TKR (TKRC) A
+      INTEGER :: A(*)
+      INTEGER(1) :: B(*)
+      INTEGER :: NROWS, NCOLS, LDA, LDB
+      END SUBROUTINE MUMPS_ZDOUBLE_FP56Z
+      SUBROUTINE MUMPS_ZDOUBLE_FP48Z(A, B, NROWS, NCOLS, LDA, LDB)
+!GCC$ ATTRIBUTES NO_ARG_CHECK :: A
+!DEC$ ATTRIBUTES NO_ARG_CHECK :: A
+!DIR$ IGNORE_TKR (TKRC) A
+      INTEGER :: A(*)
+      INTEGER(1) :: B(*)
+      INTEGER :: NROWS, NCOLS, LDA, LDB
+      END SUBROUTINE MUMPS_ZDOUBLE_FP48Z
+      SUBROUTINE MUMPS_ZDOUBLE_FP40Z(A, B, NROWS, NCOLS, LDA, LDB)
+!GCC$ ATTRIBUTES NO_ARG_CHECK :: A
+!DEC$ ATTRIBUTES NO_ARG_CHECK :: A
+!DIR$ IGNORE_TKR (TKRC) A
+      INTEGER :: A(*)
+      INTEGER(1) :: B(*)
+      INTEGER :: NROWS, NCOLS, LDA, LDB
+      END SUBROUTINE MUMPS_ZDOUBLE_FP40Z
+      SUBROUTINE MUMPS_ZDOUBLE_FP24C(A, B, NROWS, NCOLS, LDA, LDB)
+!GCC$ ATTRIBUTES NO_ARG_CHECK :: A
+!DEC$ ATTRIBUTES NO_ARG_CHECK :: A
+!DIR$ IGNORE_TKR (TKRC) A
+      INTEGER :: A(*)
