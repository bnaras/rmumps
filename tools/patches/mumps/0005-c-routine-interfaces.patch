diff --git b/src/mumps_c_interfaces.h b/src/mumps_c_interfaces.h
new file mode 100644
index 0000000..614948d
--- /dev/null
+++ b/src/mumps_c_interfaces.h
@@ -0,0 +1,49 @@
+C
+C     rmumps: explicit interfaces of C routines that MUMPS calls with
+C     arguments of several types or kinds (addresses, or integer arrays
+C     whose kind depends on how PORD/METIS were built). C ignores the
+C     Fortran type, so the arguments are exempt from type, kind and rank
+C     checking.
+C
+      INTERFACE
+      SUBROUTINE MUMPS_ADDR_C(A, ADDR)
+!GCC$ ATTRIBUTES NO_ARG_CHECK :: A
+!DEC$ ATTRIBUTES NO_ARG_CHECK :: A
+!DIR$ IGNORE_TKR (TKRC) A
+      INTEGER :: A
+      INTEGER(8) :: ADDR
+      END SUBROUTINE MUMPS_ADDR_C
+      SUBROUTINE MUMPS_SIZE_C(A, B, DIFF)
+!GCC$ ATTRIBUTES NO_ARG_CHECK :: A, B
+!DEC$ ATTRIBUTES NO_ARG_CHECK :: A, B
+!DIR$ IGNORE_TKR (TKRC) A, B
+      INTEGER :: A, B
+      INTEGER(8) :: DIFF
+      END SUBROUTINE MUMPS_SIZE_C
+      SUBROUTINE MUMPS_PORDF(NVTX, NEDGES, XADJ, ADJNCY, NV, NCMPA)
+!GCC$ ATTRIBUTES NO_ARG_CHECK :: NVTX, NEDGES, XADJ, ADJNCY, NV
+!DEC$ ATTRIBUTES NO_ARG_CHECK :: NVTX, NEDGES, XADJ, ADJNCY, NV
+!DIR$ IGNORE_TKR (TKRC) NVTX, NEDGES, XADJ, ADJNCY, NV
+      INTEGER :: NVTX(*), NEDGES(*), XADJ(*), ADJNCY(*), NV(*)
+      INTEGER :: NCMPA
+      END SUBROUTINE MUMPS_PORDF
+      SUBROUTINE MUMPS_PORDF_WND(NVTX, NEDGES, XADJ, ADJNCY, NV, NCMPA,
+     &                           TOTW)
+!GCC$ ATTRIBUTES NO_ARG_CHECK :: NVTX, NEDGES, XADJ, ADJNCY, NV, TOTW
+!DEC$ ATTRIBUTES NO_ARG_CHECK :: NVTX, NEDGES, XADJ, ADJNCY, NV, TOTW
+!DIR$ IGNORE_TKR (TKRC) NVTX, NEDGES, XADJ, ADJNCY, NV, TOTW
+      INTEGER :: NVTX(*), NEDGES(*), XADJ(*), ADJNCY(*), NV(*), TOTW(*)
+      INTEGER :: NCMPA
+      END SUBROUTINE MUMPS_PORDF_WND
+      SUBROUTINE METIS_NODEND(NVTXS, XADJ, ADJNCY, VWGT, OPTIONS,
+     &                        PERM, IPERM)
+!GCC$ ATTRIBUTES NO_ARG_CHECK :: NVTXS, XADJ, ADJNCY, VWGT, OPTIONS
+!DEC$ ATTRIBUTES NO_ARG_CHECK :: NVTXS, XADJ, ADJNCY, VWGT, OPTIONS
+!DIR$ IGNORE_TKR (TKRC) NVTXS, XADJ, ADJNCY, VWGT, OPTIONS
+!GCC$ ATTRIBUTES NO_ARG_CHECK :: PERM, IPERM
+!DEC$ ATTRIBUTES NO_ARG_CHECK :: PERM, IPERM
+!DIR$ IGNORE_TKR (TKRC) PERM, IPERM
+      INTEGER :: NVTXS(*), XADJ(*), ADJNCY(*), VWGT(*), OPTIONS(*)
+      INTEGER :: PERM(*), IPERM(*)
+      END SUBROUTINE METIS_NODEND
+      END INTERFACE
