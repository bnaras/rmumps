Why: GKlib's error functions print to stderr and then exit() or raise a
 signal, relying on SIGTERM/SIGABRT handlers that gk_sigtrap() installs
 around every METIS API call. In R neither printing nor exiting is
 allowed, and handlers for process-wide signals must not be changed.
 gk_errexit() now longjmps directly to the setjmp point of the running API
 function (gk_jbufs[gk_cur_jbufs]), which then returns METIS_ERROR* as
 designed; errexit() and calls outside an API function go to
 rmumps_fatal() (src/shim/rmumps_shim.c), which does the same or raises an
 R error. gk_sigtrap()/gk_siguntrap() keep only the jump-buffer counter.
Upstream: not sent (METIS 5.1.0 is no longer maintained in this form).
Obsolete when: METIS is replaced.

--- a/GKlib/error.c
+++ b/GKlib/error.c
@@ -23,16 +23,8 @@
 __thread jmp_buf gk_jbufs[MAX_JBUFS];
 __thread jmp_buf gk_jbuf;
 
-typedef void (*gksighandler_t)(int);
-
-/* These are the holders of the old singal handlers for the trapped signals */
-static __thread gksighandler_t old_SIGMEM_handler;  /* Custom signal */
-static __thread gksighandler_t old_SIGERR_handler;  /* Custom signal */
-static __thread gksighandler_t old_SIGMEM_handlers[MAX_JBUFS];  /* Custom signal */
-static __thread gksighandler_t old_SIGERR_handlers[MAX_JBUFS];  /* Custom signal */
-
-/* The following is used to control if the gk_errexit() will actually abort or not.
-   There is always a single copy of this variable */
+/* rmumps: the holders of the old signal handlers are gone (no handlers are
+   installed), and gk_errexit() always unwinds. */
 static int gk_exit_on_error = 1;
 
 
@@ -53,20 +45,11 @@
 /*************************************************************************/
 void errexit(char *f_str,...)
 {
-  va_list argp;
-
-  va_start(argp, f_str);
-  vfprintf(stderr, f_str, argp);
-  va_end(argp);
-
-  if (strlen(f_str) == 0 || f_str[strlen(f_str)-1] != '\n')
-        fprintf(stderr,"\n");
-  fflush(stderr);
-
-  if (gk_exit_on_error)
-    exit(-2);
-
-  /* abort(); */
+  /* rmumps: no output; unwind to the running METIS API function, which
+     then returns METIS_ERROR (rmumps_fatal() does that when
+     gk_cur_jbufs >= 0, and raises an R error otherwise). */
+  (void) f_str;
+  rmumps_fatal("METIS errexit");
 }
 
 
@@ -76,17 +59,12 @@
 /*************************************************************************/
 void gk_errexit(int signum, char *f_str,...)
 {
-  va_list argp;
-
-  va_start(argp, f_str);
-  vfprintf(stderr, f_str, argp);
-  va_end(argp);
-
-  fprintf(stderr,"\n");
-  fflush(stderr);
-
-  if (gk_exit_on_error)
-    raise(signum);
+  /* rmumps: no output and no signal; longjmp straight to the point the
+     running METIS API function returns METIS_ERROR* from. */
+  (void) f_str;
+  if (gk_cur_jbufs >= 0)
+    longjmp(gk_jbufs[gk_cur_jbufs], signum);
+  rmumps_fatal("METIS gk_errexit");
 }
 
 
@@ -102,8 +80,7 @@
 
   gk_cur_jbufs++;
 
-  old_SIGMEM_handlers[gk_cur_jbufs]  = signal(SIGMEM,  gk_sigthrow);
-  old_SIGERR_handlers[gk_cur_jbufs]  = signal(SIGERR,  gk_sigthrow);
+  /* rmumps: no signal handlers (gk_errexit() longjmps directly) */
 
   return 1;
 }
@@ -118,9 +95,6 @@
   if (gk_cur_jbufs == -1)
     return 0;
 
-  signal(SIGMEM,  old_SIGMEM_handlers[gk_cur_jbufs]);
-  signal(SIGERR,  old_SIGERR_handlers[gk_cur_jbufs]);
-
   gk_cur_jbufs--;
 
   return 1;
@@ -142,20 +116,17 @@
